# Telegram bot access
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_OWNER_ID=
TELEGRAM_TARGET_CHAT_ID=

# InsForge PostgreSQL connection. Use a server-side secret only.
INSFORGE_DATABASE_URL=

# Optional GoFile account token (can also be configured privately with /gofile token)
GOFILE_TOKEN=

# Optional worker authentication when separated from the bot
PCM_WORKER_SHARED_SECRET=

# Resource limits
MAX_CONCURRENT_DOWNLOADS=1
MAX_CONCURRENT_UPLOADS=1
MAX_URLS_PER_BATCH=10
MAX_FILE_SIZE_MB=4096
MIN_FREE_DISK_MB=2048
MAX_REDIRECT_HOPS=8
REQUEST_TIMEOUT_SECONDS=30
TEMP_DIR=/tmp/pcm
LOG_LEVEL=INFO
